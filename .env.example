# Wazuh API connection
WAZUH_API_URL=https://192.168.56.103:55000
# Alternatively host and port:
# WAZUH_HOST=192.168.56.103
# WAZUH_PORT=55000

# Wazuh API credentials
WAZUH_API_USERNAME=wazuh
WAZUH_API_PASSWORD=YOUR_API_PASSWORD_HERE

# SSL verification (set to false for self-signed certificates in local lab / VM)
WAZUH_VERIFY_SSL=false

# Wazuh Indexer (OpenSearch / Elasticsearch for alerts and events)
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=YOUR_INDEXER_PASSWORD_HERE
WAZUH_INDEXER_VERIFY_SSL=false